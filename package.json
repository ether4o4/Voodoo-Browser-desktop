{
  "name": "voodoo-browser-desktop",
  "productName": "Voodoo Browser",
  "version": "0.2.0",
  "description": "Voodoo Browser with the mobile script workbench, Magic scripts and encrypted phone link",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "test:app": "node test/app-smoke.cjs",
    "package": "node scripts/package.cjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "selfsigned": "5.5.0",
    "tldts": "7.0.19"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "electron": "45.1.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1"
  }
}
