{
  "name": "voodoo-browser-desktop",
  "productName": "Voodoo Browser",
  "version": "0.1.0",
  "description": "An on-demand Windows browser with an encrypted phone link",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "test:app": "node test/app-smoke.cjs",
    "package": "node scripts/package.cjs"
  },
  "engines": { "node": ">=24.15.0" },
  "dependencies": { "selfsigned": "5.5.0" },
  "devDependencies": {
    "electron": "45.1.0",
    "@electron/packager": "20.3.0",
    "@electron/asar": "4.3.1",
    "playwright": "1.64.1",
    "jsdom": "30.1.3"
  }
}
